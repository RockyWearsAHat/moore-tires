# Moore Tires — Environment Variables Template
# Copy to .env.local and fill in values. Never commit .env.local.

# --- MongoDB ---
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/moore-tires-dev?retryWrites=true&w=majority

# --- Redis (Upstash) ---
REDIS_URL=rediss://<password>@<host>.upstash.io:6380

# --- Clerk ---
CLERK_SECRET_KEY=sk_test_xxx
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxx
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx

# --- Twilio ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FROM_NUMBER=+15558675309
TWILIO_WEBHOOK_SIGNING_SECRET=xxxxxxxx

# --- Cloudflare R2 ---
R2_ACCOUNT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
R2_ACCESS_KEY_ID=xxxxxxxx
R2_SECRET_ACCESS_KEY=xxxxxxxx
R2_BUCKET_NAME=moore-tires-dev
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev

# --- API ---
API_PORT=3001
API_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# --- Apps ---
VITE_API_URL=http://localhost:3001
EXPO_PUBLIC_API_URL=http://localhost:3001
