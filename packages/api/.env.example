# ─── Required ─────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/moore-tires
JWT_SECRET=change-me-to-a-random-64-char-string

# ─── Optional (app works without these in dev) ───────────────────────────────
# API_PORT=3001
# CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ─── Redis / Job Queues (SMS, push, reminders — disabled if unset) ────────────
# REDIS_URL=redis://localhost:6379

# ─── Stripe (runs in mock mode if unset) ──────────────────────────────────────
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Email / SMTP (logs to console if unset) ──────────────────────────────────
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=app-password
# EMAIL_FROM=Moore Tires <noreply@mooretires.com>

# ─── Twilio SMS (requires Redis + these keys) ────────────────────────────────
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# TWILIO_FROM_NUMBER=+15558675309
# TWILIO_WEBHOOK_SIGNING_SECRET=...

# ─── App URL (used in email templates) ────────────────────────────────────────
# APP_URL=http://localhost:5173
