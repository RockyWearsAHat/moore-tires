{
  "name": "dashboard",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "tsc -b && vite build",
    "dev": "vite --port 5174",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run --passWithNoTests",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@moore-tires/shared": "workspace:*",
    "@moore-tires/ui": "workspace:*",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-router-dom": "^6.26.2",
    "socket.io-client": "^4.7.5",
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2"
  },
  "devDependencies": {
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.45",
    "rimraf": "^6.0.1",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "vite": "^5.4.3",
    "vitest": "^2.0.5"
  }
}
